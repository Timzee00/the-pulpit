# Required for public AI access. Set these in Netlify UI/API, Functions scope,
# in each intended deploy context, then redeploy. Never commit real values.
PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app
# At least ONE AI provider key. A second enables fallback.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Cloudflare Turnstile: add your production hostname; use a managed widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST URL and write token, kept on the server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters: openssl rand -hex 32
SESSION_SIGNING_SECRET=
# Shared weighted daily allowance: Versiah=2, sermons/voice=3, research/Bible=1.
# Counts attempts, including failed provider requests. Resets at 00:00 UTC.
PULPIT_DAILY_BUDGET=100
PULPIT_REQUESTS_PER_MINUTE=10
# Optional features. Leave blank until configured and tested.
BIBLE_API_KEY=
# Set true only after confirming edition and plan permissions for your use.
BIBLE_LICENSE_CONFIRMED=false
BIBLE_YO_ID=
BIBLE_HA_ID=
BIBLE_IG_ID=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_YO=
ELEVENLABS_VOICE_ID_HA=
ELEVENLABS_VOICE_ID_IG=
PULPITPEDIA_RESEARCH_MODEL=openrouter/free
