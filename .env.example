# ============================================================
#  The Pulpit — Sermon Helper AI
#  Environment Variables
# ============================================================
#
#  INSTRUCTIONS:
#  1. Copy this file and rename it to: .env (for local dev only —
#     Netlify production uses its own dashboard env vars, see below)
#  2. Fill in your real API keys below
#  3. NEVER commit .env to Git — it is already in .gitignore
#
#  For Netlify production deployment:
#  → Go to: Netlify Dashboard → Your Site → Site Settings → Environment Variables
#  → Add each variable below with your real key
#  → Redeploy the site
# ============================================================

# --- Sermon generation (at least one of these two required) ---
# Get a free Groq key (no card) at: https://console.groq.com
GROQ_API_KEY=gsk-your-key-here

# Get a free OpenRouter key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- CORS lockdown (recommended once you have a real domain) ---
# Restricts who can call your function. Defaults to "*" (anyone) if unset.
ALLOWED_ORIGIN=https://your-site.netlify.app

# --- Real Scripture text + verified Yoruba/Hausa/Igbo Bible editions (recommended) ---
# Without this, translated sermons fall back to the AI's own (much less
# reliable) translation of Bible verses instead of pulling real text from
# an actual Bible database. Free key: sign up at https://scripture.api.bible
BIBLE_API_KEY=your-key-here
# Optional: pin specific API.Bible editions. Leave blank to auto-discover
# an edition authorized for your API.Bible key.
# BIBLE_YO_ID=
# BIBLE_HA_ID=
# BIBLE_IG_ID=

# --- Azure AI Translator — primary translation engine (recommended) ---
# Real machine translation for Yoruba/Hausa/Igbo, far more reliable than
# the free LLM fallback. Free F0 tier: 2 million characters/month, ongoing.
# Sign up: https://portal.azure.com/#create/Microsoft.CognitiveServicesTextTranslation
# (needs both the key AND the region shown on the same "Keys and Endpoint" page)
AZURE_TRANSLATOR_KEY=your-key-here
AZURE_TRANSLATOR_REGION=your-region-here

# --- ElevenLabs — voice reading for Yoruba/Hausa/Igbo (optional) ---
# English read-aloud uses the browser's free built-in voice, no key needed.
# Yoruba/Hausa/Igbo mostly have no browser voice at all, so those route
# through ElevenLabs instead. Free tier is small (~10K characters/month),
# so this will run out fast with real use. Sign up: https://elevenlabs.io
ELEVENLABS_API_KEY=your-key-here
# Optional: override the default voice per language once you've tested
# a few from your ElevenLabs dashboard for pronunciation quality.
# ELEVENLABS_VOICE_ID_YO=
# ELEVENLABS_VOICE_ID_HA=
# ELEVENLABS_VOICE_ID_IG=

# --- Pulpitpedia research synthesis (optional but recommended) ---
# The research layer can still return sources when this model key is absent.
# Set an OpenRouter key above to enable evidence-constrained synthesis.
# Uses retrieved public reference metadata as evidence for a constrained synthesis.
# Never put this key in frontend code.
PULPITPEDIA_RESEARCH_MODEL=openai/gpt-4.1-mini

# --- Optional operational controls ---
# Maximum browser origin allowed to call Netlify functions. Use your final domain.
# ALLOWED_ORIGIN=https://thepulpit.example
